# ── Himam API — production ───────────────────────────────────────────────────
# Copy these into your host's environment-variable settings. Never commit a
# filled-in copy: APP_KEY and DB_PASSWORD are secrets.

APP_NAME=Himam
APP_ENV=production
APP_DEBUG=false

# Generate once with:  php artisan key:generate --show
APP_KEY=

# The API's own public URL, used to build the certificate verification links.
APP_URL=https://your-api-host.example.com

# Origin(s) allowed to call the API — your deployed frontend. Comma-separated.
FRONTEND_URL=https://your-frontend-host.example.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Most managed MySQL providers require TLS; leave this on unless yours doesn't.
MYSQL_ATTR_SSL_CA=

# These use the database, so no Redis is needed on a free tier. The tables ship
# with Laravel's own migrations and are created by `php artisan migrate`.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
